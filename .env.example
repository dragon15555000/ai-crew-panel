# Port Configuration
PORT=5057
PORT_PANEL=5057
PORT_AI_CREW_COCKPIT=5500
PORT_NEW_API=3000
PORT_DOC_PORTAL=5056
PORT_AI_ANALIZA=5000
PORT_N8N=5678
HOST=0.0.0.0

# Publiczny adres hosta. "auto" (lub puste) = wykrywanie z interfejsów sieciowych.
PUBLIC_HOST=auto

# Restart Commands (optional)
# Panel domyślnie używa komend z local_apps.json; te zmienne są tylko przykładem.
# CMD_AI_CREW="systemctl --user start ai-crew-cockpit"
# CMD_NEW_API="cd /path/to/new-api && docker compose up -d"
# CMD_AI_ANALIZA="sudo systemctl restart aianalizator"
# CMD_PANEL="systemctl --user start ai-crew-panel"
# CMD_N8N="cd /path/to/n8n && docker compose up -d"

# n8n URL (if not default)
# N8N_URL="http://localhost:5678"

# n8n API key (used by the panel's n8n tab: workflows / executions / toggle)
N8N_API_KEY=your_n8n_api_key_here

# Max events to keep in memory
MAX_EVENTS=500

# Ollama (podgląd załadowanych modeli / VRAM na panelu)
OLLAMA_URL=http://127.0.0.1:11434
# Router Ollama: dwa endpointy (na hoście z GPU np. NVIDIA + AMD-Vulkan).
OLLAMA_PRIMARY_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_NAME=NVIDIA
OLLAMA_SECONDARY_URL=http://127.0.0.1:11435
OLLAMA_SECONDARY_NAME=AMD-Vulkan
