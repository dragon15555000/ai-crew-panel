# Port Configuration
PORT=5057
PORT_AI_CREW_COCKPIT=5500
PORT_NEW_API=3000
PORT_DOC_PORTAL=5056
PORT_AI_ANALIZA=5000
PORT_PANEL=5057
PORT_N8N=5678
HOST=0.0.0.0
PUBLIC_HOST=10.10.10.164

# Restart Commands (optional)
# Uncomment and modify for auto-restart after service kill
# CMD_AI_CREW="cd /path/to/ai_crew && npm start &"
# CMD_NEW_API="cd /path/to/new-api && python main.py &"
# CMD_DOC_PORTAL="cd /path/to/doc_portal && gunicorn app:app &"
# CMD_AI_ANALIZA="cd /path/to/ai_analiza && python app.py &"
# CMD_PANEL="cd /path/to/panel && node server.js &"
# CMD_N8N="cd /path/to/n8n && n8n start &"

# n8n URL (if not default)
# N8N_URL="http://localhost:5678"

# n8n API key (used by the panel's n8n tab: workflows / executions / toggle)
N8N_API_KEY=your_n8n_api_key_here

# Max events to keep in memory
MAX_EVENTS=500

# Ollama (podgląd załadowanych modeli / VRAM na panelu)
OLLAMA_URL=http://127.0.0.1:11434
